{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.base.schema.json",
  "name": "Pairdraw",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/pairdraw,type=bind,consistency=cached",
  "workspaceFolder": "/workspace/pairdraw",
  "remoteUser": "bun",
  "updateRemoteUserUID": true,
  "mounts": [
    "source=pairdraw-root-modules-${devcontainerId},target=/workspace/pairdraw/node_modules,type=volume",
    "source=pairdraw-scene-graph-modules-${devcontainerId},target=/workspace/pairdraw/packages/scene-graph/node_modules,type=volume",
    "source=pairdraw-pen-modules-${devcontainerId},target=/workspace/pairdraw/packages/pen/node_modules,type=volume",
    "source=pairdraw-kiwi-modules-${devcontainerId},target=/workspace/pairdraw/packages/kiwi/node_modules,type=volume",
    "source=pairdraw-fig-modules-${devcontainerId},target=/workspace/pairdraw/packages/fig/node_modules,type=volume",
    "source=pairdraw-core-modules-${devcontainerId},target=/workspace/pairdraw/packages/core/node_modules,type=volume",
    "source=pairdraw-dom-css-modules-${devcontainerId},target=/workspace/pairdraw/packages/dom-css/node_modules,type=volume",
    "source=pairdraw-design-jsx-modules-${devcontainerId},target=/workspace/pairdraw/packages/design-jsx/node_modules,type=volume",
    "source=pairdraw-emit-modules-${devcontainerId},target=/workspace/pairdraw/packages/emit/node_modules,type=volume",
    "source=pairdraw-vue-modules-${devcontainerId},target=/workspace/pairdraw/packages/vue/node_modules,type=volume",
    "source=pairdraw-cli-modules-${devcontainerId},target=/workspace/pairdraw/packages/cli/node_modules,type=volume",
    "source=pairdraw-mcp-modules-${devcontainerId},target=/workspace/pairdraw/packages/mcp/node_modules,type=volume",
    "source=pairdraw-docs-modules-${devcontainerId},target=/workspace/pairdraw/packages/docs/node_modules,type=volume",
    "source=pairdraw-docs-tool-modules-${devcontainerId},target=/workspace/pairdraw/tools/docs/node_modules,type=volume"
  ],
  "postCreateCommand": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git lfs pull; fi && bun install --frozen-lockfile",
  "containerEnv": {
    "TAURI_DEV_HOST": "0.0.0.0"
  },
  "forwardPorts": [1420],
  "portsAttributes": {
    "1420": {
      "label": "Pairdraw web editor",
      "onAutoForward": "notify"
    }
  }
}
