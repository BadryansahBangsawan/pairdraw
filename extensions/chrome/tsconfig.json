{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["bun"],
    "paths": {
      "#web-capture/*": ["../../packages/web-capture/src/*"],
      "@open-pencil/web-capture": ["../../packages/web-capture/src/index.ts"],
      "@open-pencil/web-capture/capturer": ["../../packages/web-capture/src/capturer/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "build.ts"]
}
