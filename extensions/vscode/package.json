{
  "name": "pairdraw",
  "displayName": "Pairdraw",
  "version": "0.16.0",
  "private": true,
  "description": "Edit Pairdraw .fig and .pen documents in the IDE.",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "publisher": "pairdraw",
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "bun build.ts",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/vscode": "1.90.0"
  },
  "activationEvents": [
    "onCustomEditor:pairdraw.fig",
    "onCustomEditor:pairdraw.pen",
    "onCommand:pairdraw.toggleDesignMode",
    "onCommand:pairdraw.openEditor",
    "onCommand:pairdraw.exportSelection",
    "onView:pairdraw.sidebar"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "pairdraw.fig",
        "displayName": "Pairdraw Design",
        "selector": [
          {
            "filenamePattern": "*.fig"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "pairdraw.pen",
        "displayName": "Pairdraw Design",
        "selector": [
          {
            "filenamePattern": "*.pen"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "pairdraw.toggleDesignMode",
        "title": "Toggle Design Mode",
        "category": "Pairdraw"
      },
      {
        "command": "pairdraw.openEditor",
        "title": "Open Pairdraw Editor",
        "category": "Pairdraw"
      },
      {
        "command": "pairdraw.exportSelection",
        "title": "Export Selection as PNG",
        "category": "Pairdraw"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pairdraw.toggleDesignMode",
          "when": "resourceExtname == .pen",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Pairdraw",
      "properties": {
        "pairdraw.editorUrl": {
          "type": "string",
          "default": "http://localhost:1420",
          "scope": "application",
          "markdownDescription": "URL of the running Pairdraw web editor that the custom editor loads. Use an `https` URL, or `http` on loopback for a local `bun run dev` server."
        }
      }
    },
    "viewContainers": {
      "activitybar": [
        {
          "id": "pairdraw",
          "title": "Pairdraw",
          "icon": "media/pairdraw.svg"
        }
      ]
    },
    "views": {
      "pairdraw": [
        {
          "id": "pairdraw.sidebar",
          "name": "Actions",
          "type": "webview"
        }
      ]
    }
  },
  "engines": {
    "vscode": "^1.90.0"
  }
}
