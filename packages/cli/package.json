{
  "name": "@pairdraw/cli",
  "version": "0.21.1",
  "description": "Headless command line for Pairdraw: inspect and query design documents, export images and code, lint, analyze tokens, and script the running editor.",
  "keywords": [
    "pairdraw",
    "design",
    "figma",
    "cli",
    "export",
    "lint",
    "design-tokens"
  ],
  "license": "MIT",
  "author": "Badryansah Bangsawan",
  "homepage": "https://github.com/BadryansahBangsawan/pairdraw/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/BadryansahBangsawan/pairdraw/issues"
  },
  "type": "module",
  "imports": {
    "#cli/*": "./src/*.ts",
    "#cli-tests/*": "./tests/*.ts"
  },
  "bin": {
    "pairdraw": "./bin/pairdraw.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./commands": {
      "types": "./dist/commands/index.d.mts",
      "bun": "./src/commands/index.ts",
      "import": "./dist/commands/index.mjs",
      "default": "./dist/commands/index.mjs"
    },
    "./library": {
      "types": "./dist/library/index.d.mts",
      "bun": "./src/library/index.ts",
      "import": "./dist/library/index.mjs",
      "default": "./dist/library/index.mjs"
    }
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bunx tsdown --config tsdown.config.ts",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BadryansahBangsawan/pairdraw.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@pairdraw/core": "workspace:*",
    "@pairdraw/dom-css": "workspace:*",
    "@pairdraw/mcp": "workspace:*",
    "@pairdraw/scene-graph": "workspace:*",
    "@valibot/to-json-schema": "^1.8.0",
    "agentfmt": "^0.1.3",
    "ai": "^7.0.127",
    "citty": "^0.1.6",
    "es-toolkit": "^1.52.0",
    "js-base64": "^3.9.3",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@pairdraw/fig": "workspace:*",
    "@types/bun": "^1.3.14"
  }
}
