# The Node runtime reads durable settings from this TOML file.
PAIRDRAW_CLOUD_CONFIG=./pairdraw-cloud.toml
# The site build (`bun run build:cloud`): the editor, sign-in, account, and administration pages.
PAIRDRAW_CLOUD_SITE_DIR=./dist-cloud
PORT=8787

# Required secrets. The conventional names below are the TOML defaults.
DATABASE_URL=postgresql://pairdraw:pairdraw-development-password@localhost:54329/pairdraw
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
S3_ACCESS_KEY_ID=pairdraw
S3_SECRET_ACCESS_KEY=pairdraw-development-secret

# Optional secrets are required only when their corresponding TOML section is enabled.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_PRIVATE_KEY=
# S3_SESSION_TOKEN=
# PAIRDRAW_CLOUD_SMTP_USER=
# PAIRDRAW_CLOUD_SMTP_PASSWORD=
# PAIRDRAW_CLOUD_AI_SIGNING_KEY=
# PAIRDRAW_CLOUD_SERVICE_TOKEN=

# The AI relay (`node dist-standalone/ai-relay.mjs`) reads its own TOML file and upstream key.
# PAIRDRAW_AI_RELAY_CONFIG=./pairdraw-ai-relay.toml
# PAIRDRAW_AI_RELAY_UPSTREAM_KEY=

# Compose infrastructure settings, not Cloud application configuration.
POSTGRES_PASSWORD=pairdraw-development-password
S3_REGION=us-east-1
S3_BUCKET=pairdraw

# After approving and signing in the first operator, grant the deployment admin role with:
# bun --filter @pairdraw/cloud admin grant owner@example.com
