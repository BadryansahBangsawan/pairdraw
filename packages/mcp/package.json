{
  "name": "@pairdraw/mcp",
  "version": "0.21.1",
  "description": "Model Context Protocol server for Pairdraw: inspect and edit designs over stdio or HTTP, and run coding agents for the web app.",
  "keywords": [
    "pairdraw",
    "mcp",
    "model-context-protocol",
    "ai",
    "agents",
    "design"
  ],
  "license": "MIT",
  "author": "Badryansah Bangsawan",
  "homepage": "https://github.com/BadryansahBangsawan/pairdraw/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/BadryansahBangsawan/pairdraw/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BadryansahBangsawan/pairdraw.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "pairdraw-mcp": "./dist/stdio.mjs",
    "pairdraw-mcp-http": "./dist/index.mjs",
    "pairdraw-connect": "./dist/connect.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/server.mjs",
  "imports": {
    "#mcp/*": {
      "types": "./src/*.ts",
      "bun": "./src/*.ts",
      "default": "./dist/*.mjs"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    },
    "./stdio": {
      "types": "./dist/stdio.d.mts",
      "import": "./dist/stdio.mjs",
      "default": "./dist/stdio.mjs"
    },
    "./transport": {
      "types": "./dist/transport.d.mts",
      "bun": "./src/transport/paths.ts",
      "import": "./dist/transport.mjs",
      "default": "./dist/transport.mjs"
    },
    "./discovery": {
      "types": "./dist/discovery.d.mts",
      "bun": "./src/transport/discovery.ts",
      "import": "./dist/discovery.mjs",
      "default": "./dist/discovery.mjs"
    },
    "./tools": {
      "types": "./dist/tools.d.mts",
      "bun": "./src/tool/index.ts",
      "import": "./dist/tools.mjs",
      "default": "./dist/tools.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bunx tsdown --config tsdown.config.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/server": "^2.0.0",
    "@pairdraw/core": "workspace:*",
    "@valibot/to-json-schema": "^1.8.0",
    "es-toolkit": "^1.52.0",
    "hono": "^4.13.13",
    "js-base64": "^3.9.3",
    "package-manager-detector": "^1.8.0",
    "valibot": "^1.5.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/ws": "^8.18.1"
  }
}
