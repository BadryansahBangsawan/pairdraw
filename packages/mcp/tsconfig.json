{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "#mcp/*": ["./src/*"],
      "#skills/*": ["../../skills/*"]
    },
    "noCheck": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/global.d.ts",
    "src/index.ts",
    "src/connect.ts",
    "src/server.ts",
    "src/stdio.ts",
    "src/transport/**/*.ts",
    "src/skill/**/*.ts"
  ]
}
