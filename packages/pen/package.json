{
  "name": "@pairdraw/pen",
  "version": "0.16.1",
  "description": "Pencil.dev .pen document parser and SceneGraph adapter for Pairdraw.",
  "keywords": [
    "pairdraw",
    "pen",
    "design",
    "parser"
  ],
  "license": "MIT",
  "author": "Badryansah Bangsawan",
  "homepage": "https://github.com/BadryansahBangsawan/pairdraw/tree/main/packages/pen#readme",
  "bugs": {
    "url": "https://github.com/BadryansahBangsawan/pairdraw/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BadryansahBangsawan/pairdraw.git",
    "directory": "packages/pen"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bunx tsdown --config tsdown.config.ts",
    "check": "bun run typecheck && bun run build",
    "prepack": "bun run build",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "es-toolkit": "^1.52.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "js-base64": "^3.9.3",
    "tsdown": "^0.22.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "peerDependencies": {
    "@pairdraw/scene-graph": "workspace:*"
  }
}
