{
  "name": "@open-pencil/web-capture",
  "version": "0.16.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-pencil/open-pencil.git",
    "directory": "packages/web-capture"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#web-capture/*": {
      "types": "./src/*.ts",
      "bun": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#web-capture-tests/*": "./tests/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./capturer": {
      "types": "./dist/capturer.d.ts",
      "bun": "./src/capturer/index.ts",
      "import": "./dist/capturer.js",
      "default": "./dist/capturer.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bunx tsdown --config tsdown.config.ts",
    "check": "bun run typecheck && bun run build",
    "prepack": "bun run build",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "entities": "^8.0.0",
    "es-toolkit": "^1.52.0",
    "fflate": "^0.8.3",
    "js-base64": "^3.9.3",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "happy-dom": "^20.14.6",
    "tsdown": "^0.22.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
